rules_version = '2';

/* ダイスダンジョン ―― 記録の置き場のきまり

   ここが唯一の防壁。ブラウザ側のコード（index.html の firebaseConfig）は
   誰でも読めるので守りにはならない。守っているのはこのファイル。

   決めていること
     ・自分の games/dicedungeon/players/{uid} だけ読み書きできる
     ・一覧（list）は誰にも許さない。uid を総なめされないため
     ・形が違うもの、大きすぎるものは受け取らない
     ・meta（周をまたぐ記録）と run（途中の潜行の控え）の2つだけ

   直したら必ず配ること：  firebase deploy --only firestore:rules

   ★ このプロジェクトを別のゲームと相乗りさせるとき ★
     firestore.rules はプロジェクトに1つしか置けず、deploy は丸ごと差し替える。
     つまり **このファイルを配ると、他のゲームのルールは消える**。
     相乗りさせるなら、
       ① 下の「ダイスダンジョン」の match ブロックを、
          相手のルールファイルへそのまま貼り足す
       ② いちばん下の「全部だめ」のブロックは貼らない
          （相手のゲームのパスまで塞いでしまうため）
     置き場所を games/dicedungeon/… にしてあるので、パスはぶつからない。      */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ===== ここから ダイスダンジョン（相乗りするならこの塊を持っていく） ===== */

    function ddSignedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* 送られてくる形の見張り。壊れたものや無闇に大きいものを弾く */
    function ddWellFormed() {
      let d = request.resource.data;
      let m = d.meta;
      return d.keys().hasOnly(['v', 'meta', 'run', 'at'])
          && d.v is number
          && d.meta is map
          /* run は途中の潜行の控え。中身は毎版で変わるので形は見ない。
             遊んでいない間は null が入る */
          && (!d.keys().hasAny(['run']) || d.run == null || d.run is map)
          && m.keys().hasOnly(
               ['codex','rooms','elem','mats','seen','areas','ended','hall','runs','best','tutSeen','newsSeen'])
          && (!m.keys().hasAny(['hall']) || (m.hall is list && m.hall.size() <= 50))
          && (!m.keys().hasAny(['runs']) || m.runs is number)
          && (!m.keys().hasAny(['best']) || m.best is number);
    }

    match /games/dicedungeon/players/{uid} {
      allow get:            if ddSignedInAs(uid);
      allow list:           if false;          /* 誰の記録があるかは見せない */
      allow create, update: if ddSignedInAs(uid) && ddWellFormed();
      allow delete:         if ddSignedInAs(uid);
    }

    /* ===== ここまで ダイスダンジョン ===== */

    /* ほかは全部だめ。書き忘れたパスが素通りしないように最後で閉じる。
       ★ 相乗りさせるときは、この4行は持っていかない ★ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
